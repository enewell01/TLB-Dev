---
// src/components/GoogleReviews.astro
import { getCollection } from 'astro:content';

const GOOGLE_PLACE_ID = 'ChIJ02xlBFQPvgERDzFNs4SGU7c';
const readReviewsUrl = `https://www.google.com/maps/place/?q=place_id:${GOOGLE_PLACE_ID}`;
const writeReviewUrl = `https://search.google.com/local/writereview?placeid=${GOOGLE_PLACE_ID}`;

const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
---

<section class="google-reviews">
  <div class="container">
    <p class="section-label">What Customers Say</p>
    <h2 class="section-title">Google Reviews</h2>

    <div class="reviews-carousel" data-reviews-carousel>
      <button type="button" class="reviews-arrow reviews-arrow-prev" data-reviews-prev aria-label="Previous review">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>

      <div class="reviews-viewport" data-reviews-viewport role="region" aria-live="polite" aria-label="Customer reviews">
        {reviews.map((r, i) => (
          <article class="review-card" data-review-card data-state={i === 0 ? 'active' : 'hidden'}>
            <svg class="review-quote-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
            </svg>
            <p class="review-text">{r.data.text}</p>
            <div class="review-meta">
              <span class="review-name">{r.data.name}</span>
              <span class="review-sep" aria-hidden="true">&middot;</span>
              <span class="review-date">{r.data.monthYear}</span>
              <span class="review-google-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Google Review
              </span>
            </div>
          </article>
        ))}
      </div>

      <button type="button" class="reviews-arrow reviews-arrow-next" data-reviews-next aria-label="Next review">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg>
      </button>
    </div>

    <p class="reviews-counter" data-reviews-counter>1 / {reviews.length}</p>

    <div class="reviews-actions">
      <a href={readReviewsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Read Our Reviews</a>
      <a href={writeReviewUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark">Leave a Review</a>
    </div>
  </div>
</section>

<style>
  .google-reviews { padding: 5rem 0; background: var(--off-white); text-align: center; }

  .reviews-carousel {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 700px;
    margin: 2rem auto 0;
  }

  .reviews-arrow {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--gray);
    color: var(--charcoal);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .reviews-arrow:hover { border-color: var(--red); color: var(--red); }

  .reviews-viewport {
    flex: 1 1 auto;
    min-width: 0;
    position: relative;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .reviews-viewport { transition: height 0.3s ease; }
  }

  .review-card {
    background: var(--white);
    border: 1px solid var(--gray);
    border-radius: 12px;
    padding: 2rem;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .review-card[data-state="active"] {
    position: relative;
    height: 100%;
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }
  .review-card[data-state="hidden"] {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .review-card {
      transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1), transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }
    .review-card.no-transition { transition: none; }
  }
  .review-quote-icon { color: var(--red); margin: 0 auto 1rem; }
  .review-text {
    color: var(--charcoal);
    line-height: 1.7;
    font-size: 1rem;
  }
  .review-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--charcoal);
  }
  .review-sep { color: var(--text-muted); }
  .review-date { color: var(--text-muted); font-weight: 600; }
  .review-google-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .reviews-counter {
    margin-top: 1rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .reviews-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 600px) {
    .reviews-carousel { gap: 0.5rem; }
    .review-card { padding: 1.5rem 1.25rem; min-height: 260px; }
  }

</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-reviews-carousel]');
  const counter = document.querySelector<HTMLElement>('[data-reviews-counter]');

  if (root && counter) {
    const viewport = root.querySelector<HTMLElement>('[data-reviews-viewport]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-review-card]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-reviews-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-reviews-next]');
    let index = 0;
    let timer: number | undefined;
    let resizeTimer: number | undefined;

    const SLIDE_DISTANCE = 32;

    // Lock the viewport to the tallest review's natural height so the
    // section doesn't resize as shorter/longer reviews rotate through.
    function updateHeight() {
      if (!viewport || cards.length === 0) return;
      const tallest = Math.max(...cards.map((card) => card.offsetHeight));
      viewport.style.height = `${tallest}px`;
    }

    updateHeight();
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(updateHeight, 150);
    });
    if ('fonts' in document) {
      document.fonts.ready.then(updateHeight);
    }

    function show(newIndex: number, direction: 1 | -1) {
      if (newIndex === index) return;
      const outgoing = cards[index];
      const incoming = cards[newIndex];

      // Place the incoming card off-screen on the entry side, instantly.
      incoming.classList.add('no-transition');
      incoming.dataset.state = 'hidden';
      incoming.style.transform = `translateX(${direction * SLIDE_DISTANCE}px) scale(0.97)`;
      void incoming.offsetWidth; // flush the starting position before animating
      incoming.classList.remove('no-transition');

      // Animate the outgoing card out to the opposite side, and the incoming card into place.
      outgoing.style.transform = `translateX(${-direction * SLIDE_DISTANCE}px) scale(0.97)`;
      outgoing.dataset.state = 'hidden';

      incoming.dataset.state = 'active';
      incoming.style.transform = '';

      index = newIndex;
      counter!.textContent = `${index + 1} / ${cards.length}`;

      window.setTimeout(() => {
        outgoing.style.transform = '';
      }, 500);
    }

    function next() {
      show((index + 1) % cards.length, 1);
    }

    function prev() {
      show((index - 1 + cards.length) % cards.length, -1);
    }

    function start() {
      timer = window.setInterval(next, 5000);
    }

    function stop() {
      window.clearInterval(timer);
    }

    nextBtn?.addEventListener('click', () => {
      next();
      stop();
      start();
    });
    prevBtn?.addEventListener('click', () => {
      prev();
      stop();
      start();
    });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    if (cards.length > 1) start();
  }
</script>
