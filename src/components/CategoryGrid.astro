---
import { getCollection } from 'astro:content';

const icons = [
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 7V3H2v18h20V7H12zm-2 12H4v-2h6v2zm0-4H4v-2h6v2zm0-4H4V9h6v2zm0-4H4V5h6v2zm10 12h-8V9h8v10zm-2-8h-4v2h4v-2zm0 4h-4v2h4v-2z"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 7H16V4l-3-3H5C3.9 1 3 1.9 3 3v11c0 1.1.9 2 2 2h1v2c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2v-9c0-1.66-1.34-3-3-3zm0 13H8v-2h6c1.1 0 2-.9 2-2V9h1.5c.83 0 1.5.67 1.5 1.5V18c0 1.1-.9 2-2 2z"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>`,
];

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="category-grid">
  {categories.map((cat, i) => (
    <a href={`${base}/services#${cat.id}`} class="category-card">
      <div class="category-card-icon" set:html={icons[i % icons.length]} />
      <h3 class="category-card-title">{cat.data.h1}</h3>
      <p class="category-card-description">{cat.data.metaDescription}</p>
      <span class="category-card-link">Explore {cat.data.h1} &rarr;</span>
    </a>
  ))}
</div>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .category-card {
    display: block;
    text-decoration: none;
    background: var(--white);
    border-radius: 8px;
    padding: 2rem;
    border: 1px solid var(--gray);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(54, 52, 54, 0.1);
    border-color: var(--red);
  }

  .category-card-icon {
    width: 44px;
    height: 44px;
    color: var(--red);
    margin-bottom: 1.25rem;
  }

  .category-card-icon svg {
    width: 100%;
    height: 100%;
  }

  .category-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 0.625rem;
  }

  .category-card-description {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .category-card-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--red);
  }

  @media (max-width: 900px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
