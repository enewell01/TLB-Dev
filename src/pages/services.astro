---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ServiceDirectory from '../components/ServiceDirectory.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import ContactForm from '../components/ContactForm.astro';

const title = 'Electrical Services in Moncton, NB | TLB Electric';
const description = 'Residential, commercial, panel upgrades, and EV/emergency electrical services in Moncton, Dieppe & Riverview, NB. Licensed electrician. Free quotes.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tlbelectric.ca/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://tlbelectric.ca/services' },
  ],
};
---

<Layout title={title} description={description} additionalSchemas={[breadcrumbSchema]}>
  <Header />
  <main>
    <PageHero
      breadcrumbItems={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }]}
      eyebrow="Greater Moncton, NB"
      h1="Our Electrical Services"
      intro="TLB Electric covers residential, commercial, panel and power, EV charging, new construction, and emergency electrical work across Moncton, Dieppe, and Riverview. Everything we do is listed below."
    />
    <section class="services-overview">
      <div class="container">
        <ServiceDirectory />
      </div>
    </section>
    <QuoteCTA />
    <ContactForm />
  </main>
  <Footer />
</Layout>

<style>
  .services-overview {
    padding: 5rem 0;
    background: var(--off-white);
  }
</style>
